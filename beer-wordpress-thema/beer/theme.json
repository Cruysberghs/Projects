{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1180px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "creme", "name": "Crème", "color": "#FDF3EA" },
				{ "slug": "perzik", "name": "Perzik", "color": "#F6DCC6" },
				{ "slug": "wit", "name": "Warm wit", "color": "#FFFDFB" },
				{ "slug": "terracotta", "name": "Terracotta", "color": "#D9673F" },
				{ "slug": "terracotta-donker", "name": "Terracotta donker", "color": "#B9502C" },
				{ "slug": "bruin", "name": "Bruin", "color": "#6B3A26" },
				{ "slug": "tekst", "name": "Tekst", "color": "#5A3A2A" }
			],
			"gradients": [
				{ "slug": "zacht", "name": "Zacht perzik", "gradient": "linear-gradient(120deg, #FDF3EA 0%, #F6DCC6 100%)" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 4.5rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "name": "Klein", "size": "0.9rem" },
				{ "slug": "medium", "name": "Normaal", "size": "1.05rem" },
				{ "slug": "large", "name": "Groot", "size": "1.25rem" },
				{ "slug": "x-large", "name": "Extra groot", "size": "2.4rem", "fluid": { "min": "1.8rem", "max": "2.6rem" } },
				{ "slug": "xx-large", "name": "Reuze", "size": "3.6rem", "fluid": { "min": "2.4rem", "max": "3.8rem" } }
			],
			"fontFamilies": [
				{
					"slug": "fredoka", "name": "Fredoka (titels)", "fontFamily": "Fredoka, Nunito, sans-serif",
					"fontFace": [ { "fontFamily": "Fredoka", "fontWeight": "300 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fredoka.woff2" ] } ]
				},
				{
					"slug": "nunito", "name": "Nunito (tekst)", "fontFamily": "Nunito, system-ui, sans-serif",
					"fontFace": [ { "fontFamily": "Nunito", "fontWeight": "200 1000", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunito.woff2" ] } ]
				},
				{
					"slug": "caveat", "name": "Caveat (handschrift)", "fontFamily": "Caveat, cursive",
					"fontFace": [ { "fontFamily": "Caveat", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/caveat.woff2" ] } ]
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [ { "slug": "zacht", "name": "Zacht", "shadow": "0 10px 30px rgba(140, 80, 40, .12)" } ]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--creme)", "text": "var(--wp--preset--color--tekst)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--nunito)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
		"spacing": {
			"blockGap": "1.2rem",
			"padding": { "left": "20px", "right": "20px" }
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--terracotta)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--fredoka)", "fontWeight": "500", "lineHeight": "1.15" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "color": { "text": "var(--wp--preset--color--bruin)" }, "typography": { "fontSize": "1.25rem" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--terracotta)" },
				":hover": { "color": { "text": "var(--wp--preset--color--terracotta-donker)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--terracotta)", "text": "#ffffff" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.8em", "bottom": "0.8em", "left": "1.6em", "right": "1.6em" } },
				"typography": { "fontWeight": "600", "fontSize": "1rem" },
				"shadow": "0 6px 16px rgba(217, 103, 63, .3)",
				":hover": { "color": { "background": "var(--wp--preset--color--terracotta-donker)", "text": "#ffffff" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "0.95rem", "fontWeight": "600" } },
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--fredoka)", "fontSize": "2rem", "fontWeight": "500", "letterSpacing": "0.04em" },
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--terracotta)" }, "typography": { "textDecoration": "none" } } }
			},
			"core/details": {
				"color": { "background": "var(--wp--preset--color--wit)" },
				"border": { "radius": "16px" },
				"shadow": "var(--wp--preset--shadow--zacht)",
				"spacing": { "padding": { "top": "18px", "bottom": "18px", "left": "22px", "right": "22px" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-zonder-titel", "title": "Pagina zonder titel (volle breedte)", "postTypes": [ "page" ] }
	]
}
